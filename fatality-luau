local function createButton(parent, text, accent)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 24)
	btn.BackgroundColor3 = Color3.fromRGB(20, 20, 22)
	btn.BorderSizePixel = 0
	btn.Text = text
	btn.Font = Enum.Font.GothamMedium
	btn.TextSize = 11
	btn.TextColor3 = TEXT
	btn.AutoButtonColor = false
	btn.ZIndex = 6
	btn.Parent = parent

	local btnStroke = Instance.new("UIStroke")
	btnStroke.Color = Color3.fromRGB(45, 45, 50)
	btnStroke.Thickness = 1
	btnStroke.Parent = btn

	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.15), {
			BackgroundColor3 = accent and ACCENT or Color3.fromRGB(30, 30, 35)
		}):Play()
		btnStroke.Color = accent and ACCENT or Color3.fromRGB(80, 80, 90)
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.15), {
			BackgroundColor3 = Color3.fromRGB(20, 20, 22)
		}):Play()
		btnStroke.Color = Color3.fromRGB(45, 45, 50)
	end)

	return btn
end

